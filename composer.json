{
  "name": "kobbaz/static-publisher",
  "description": "Monorepo for Static Publisher Core and add-ons.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3",
    "ext-dom": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.5 || ^7.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.2",
    "yoast/phpunit-polyfills": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "SWPP\\Core\\": "plugins/kobbaz-static-publisher/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SWPP\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "syntax": "php tools/php-syntax.php",
    "test": "phpunit",
    "lint": "phpcs",
    "analyse": "phpstan analyse --memory-limit=2G --debug -vvv",
    "check": ["@syntax", "@lint", "@analyse", "@test"]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
