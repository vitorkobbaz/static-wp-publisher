includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  level: 7
  paths:
    - plugins/static-wp-publisher/src
    - plugins/static-wp-publisher-export/src
  scanFiles:
    - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    - tests/phpstan-bootstrap.php
  excludePaths:
    analyse:
      - tests
