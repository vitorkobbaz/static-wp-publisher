<?xml version="1.0"?>
<ruleset name="Static WP Publisher">
    <description>WordPress coding standards for Static WP Publisher.</description>
    <file>plugins</file>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <rule ref="WordPress"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array" value="swpp,SWPP"/>
        </properties>
    </rule>
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
